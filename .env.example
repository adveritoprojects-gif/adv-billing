# Neon Postgres connection string for the clinic database.
# Get it from the Neon dashboard: Project -> Connect -> "Connection string".
# Format: postgresql://USER:PASSWORD@HOST:PORT/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-YYYY.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign staff session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Optional: default admin account created by `npm run db:seed` (defaults: admin / admin123)
# STAFF_SEED_USERNAME="admin"
# STAFF_SEED_PASSWORD="change-me"
# STAFF_SEED_NAME="Administrator"

# After setting these, run:
#   npx prisma generate
#   npx prisma db push
#   npm run db:seed